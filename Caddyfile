{
    on_demand_tls {
        ask http://127.0.0.1:4000/api/internal/domains/tls
    }
    servers {
        strict_sni_host on
        # Cloudflare ranges verified 2026-11-05 against cloudflare.com/ips-v4 and ips-v6.
        # Trust visitor headers only when the connecting peer belongs to Cloudflare.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

# Caddyfile for Sponsor.krd Platform
# This reverse proxy handles:
# - Wildcard TLS for *.sponsor.krd
# - Subdomain routing to the Next.js frontend
# - All /api/* traffic proxied to NestJS backend (port 4000)
# - Host header preservation for subdomain extraction in the Next.js proxy

*.sponsor.krd {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    # Never trust a tenant header supplied by an external client. The backend
    # derives the tenant from the preserved Host header for direct API traffic.
    request_header -x-subdomain
    request_header -x-tenant-proxy-key
    request_header -x-forwarded-host
    @internal path /api/internal/*
    respond @internal 404

    @api path /api/*
    header @api X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy @api localhost:4000 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy localhost:3011 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

sponsor.krd, www.sponsor.krd {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    # Never trust a tenant header supplied by an external client. The backend
    # derives the tenant from the preserved Host header for direct API traffic.
    request_header -x-subdomain
    request_header -x-tenant-proxy-key
    request_header -x-forwarded-host
    @internal path /api/internal/*
    respond @internal 404

    @api path /api/*
    header @api X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy @api localhost:4000 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy localhost:3011 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Customer-owned domains: certificates are allowed only for verified active mappings.
https:// {
    tls {
        on_demand
    }
    request_header -x-subdomain
    request_header -x-tenant-proxy-key
    request_header -x-forwarded-host
    @internal path /api/internal/*
    respond @internal 404
    @api path /api/*
    header @api X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy @api localhost:4000 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
    reverse_proxy localhost:3011 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

